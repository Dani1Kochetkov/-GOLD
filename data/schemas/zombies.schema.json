{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gold/zombies.schema.json",
  "title": "GOLD DAYZ — zombies.json",
  "type": "object",
  "required": ["meta", "zombies"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer" } } },
    "zombies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model", "health", "speedWalk", "speedRun", "damage", "attackRange", "attackRate", "detectRange", "chaseRange", "lootTable", "spawnWeight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "model": { "type": "string" },
          "health": { "type": "number", "exclusiveMinimum": 0 },
          "speedWalk": { "type": "number", "minimum": 0 },
          "speedRun": { "type": "number", "minimum": 0 },
          "damage": { "type": "number", "exclusiveMinimum": 0 },
          "attackRange": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
          "attackRate": { "type": "integer", "minimum": 200 },
          "detectRange": { "type": "number", "exclusiveMinimum": 0 },
          "chaseRange": { "type": "number", "exclusiveMinimum": 0 },
          "score": { "type": "number", "minimum": 0 },
          "lootTable": { "type": "string" },
          "spawnWeight": { "type": "number", "minimum": 0 },
          "onScream": {
            "type": "object",
            "properties": {
              "radius": { "type": "number" },
              "aggro": { "type": "number" },
              "cooldown": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
