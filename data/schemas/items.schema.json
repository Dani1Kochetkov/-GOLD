{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gold/items.schema.json",
  "title": "GOLD DAYZ — items.json",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "updated": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "slot": {
      "enum": ["none", "primary", "melee", "back", "armor", "mask", "hands"]
    },
    "rarity": {
      "enum": ["common", "uncommon", "rare", "epic", "legendary"]
    },
    "weapon": {
      "type": "object",
      "required": ["hash", "damage", "range", "rate"],
      "additionalProperties": false,
      "properties": {
        "hash": { "type": "integer", "minimum": 1 },
        "damage": { "type": "number", "exclusiveMinimum": 0 },
        "range": { "type": "number", "exclusiveMinimum": 0 },
        "rate": { "type": "integer", "minimum": 50 },
        "ammoType": { "type": ["string", "null"] },
        "mag": { "type": "integer", "minimum": 0 },
        "noise": { "type": "number", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "slot", "weight", "stack"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "desc": { "type": "string", "maxLength": 200 },
        "icon": { "type": "string", "maxLength": 4 },
        "slot": { "$ref": "#/definitions/slot" },
        "weight": { "type": "number", "minimum": 0 },
        "stack": { "type": "integer", "minimum": 1 },
        "rarity": { "$ref": "#/definitions/rarity" },
        "kind": { "type": "string" },
        "usable": { "type": "boolean" },
        "equipable": { "type": "boolean" },
        "storage": { "type": "integer", "minimum": 0 },
        "damageReduction": { "type": "number", "minimum": 0, "maximum": 1 },
        "gasProtection": { "type": "number", "minimum": 0, "maximum": 1 },
        "radio": { "type": "boolean" },
        "reusable": { "type": "boolean" },
        "ammo": { "type": "boolean" },
        "unlocksMap": { "type": "boolean" },
        "model": { "type": "string" },
        "weapon": { "$ref": "#/definitions/weapon" },
        "heal": {
          "type": "object",
          "properties": {
            "blood": { "type": "number" },
            "health": { "type": "number" },
            "radiation": { "type": "number" },
            "time": { "type": "integer", "minimum": 0 }
          }
        },
        "food": {
          "type": "object",
          "properties": {
            "calories": { "type": "number" },
            "water": { "type": "number" },
            "time": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
