# ─────────────────────────────────────────────────────────────────────────────
#  RAGE:MP / GOLD — server configuration
#  Copy this file to .env and edit the values, then: docker compose up -d --build
#  Values with spaces MUST be quoted: RAGE_NAME="GOLD [RU] Roleplay"
# ─────────────────────────────────────────────────────────────────────────────

# --- identity ---------------------------------------------------------------
# Shown in the RAGE:MP server browser. Use [tags] to highlight game mode.
RAGE_NAME="GOLD [RU] Freeroam"
# us | ru | de | fr | es | pl | br | tr | ... (flag in the server list)
RAGE_LANGUAGE=ru
# Public site of the project (optional, may stay empty).
RAGE_URL=
# Announce to the RAGE:MP master list so players can find the server.
# Set to true only when the server is reachable from the internet.
RAGE_ANNOUNCE=false
# Folder name inside server-data/packages that acts as the game mode entry.
RAGE_GAMEMODE=freeroam
# Persistent domain name instead of a bare IP (optional but recommended):
# players keep the same address if you migrate to another host.
# RAGE_FQDN=game.example.com

# --- network ----------------------------------------------------------------
# Game port. RAGE:MP uses this port over BOTH UDP and TCP.
RAGE_PORT=22005
# HTTP port for client package downloads. MUST be RAGE_PORT + 1.
RAGE_HTTP_PORT=22006
# Bind address. Keep 0.0.0.0 inside a container.
RAGE_BIND=0.0.0.0

# --- gameplay / limits ------------------------------------------------------
RAGE_MAXPLAYERS=32
# Entity streaming distance in metres (100–1500; higher = more CPU/bandwidth).
RAGE_STREAM_DISTANCE=500
# Sync interval in ms (40 = 25 updates/sec; lower = smoother but hungrier).
RAGE_SYNC_RATE=40
RAGE_VOICE_CHAT=true
# 8000 | 16000 | 24000 | 48000
RAGE_VOICE_CHAT_SAMPLE_RATE=24000
# Kick players whose ping / packet loss is too high (empty = no limit).
RAGE_MAX_PING=200
# RAGE_MAX_PACKET_LOSS=0.1
# RAGE_MIN_FPS=20
# Only weapons spawned by server-side scripts are synced (anti-cheat friendly).
RAGE_SERVER_SIDE_WEAPONS_ONLY_MODE=true
# Allow several players from one IP (useful behind NAT, bad for abuse).
RAGE_DISALLOW_MULTIPLE_CONNECTIONS_PER_IP=false

# --- scripting --------------------------------------------------------------
RAGE_ENABLE_NODEJS=true
# "enabled" only if you use the C# bridge (dotnet/resources).
RAGE_CSHARP=disabled
# Extra Node.js flags, e.g. --max-old-space-size=2048
# RAGE_NODE_COMMANDLINE_FLAGS=--max-old-space-size=2048

# --- content delivery -------------------------------------------------------
# Serve client packages from an external HTTP host (FastDL). See extras/fastdl.
# RAGE_FASTDL_HOST=https://dl.example.com
# RAGE_CREATE_FASTDL_SNAPSHOT=true

# --- container runtime ------------------------------------------------------
# UID/GID that owns ./server-data on the host (run `id -u` / `id -g`).
# Keep 1000:1000 for a typical first user; change for a dedicated game user.
RAGEMP_UID=1000
RAGEMP_GID=1000
TZ=Europe/Moscow
# generate = conf.json is rebuilt from this file on every start (recommended)
# keep     = use a hand-edited server-data/conf.json and never overwrite it
RAGE_CONF_MODE=generate

# --- optional database (docker compose --profile db) ------------------------
# MariaDB is not exposed to the internet; connect from the server by host "mariadb".
MARIADB_DATABASE=ragemp
MARIADB_USER=ragemp
MARIADB_PASSWORD=change-me-please
MARIADB_ROOT_PASSWORD=change-me-root-too
MARIADB_PORT=3306
ADMINER_PORT=8080
