{
  "name": "gold-dayz",
  "version": "0.1.0",
  "private": true,
  "description": "GOLD DAYZ — DayZ-сервер на RAGE Multiplayer (GTA 5): зомби, инвентарь, карта",
  "scripts": {
    "build": "node tools/build-client.js",
    "check": "node tools/check.js",
    "test": "node tools/test.js",
    "sim": "node tools/sim.js --players 6 --seconds 60",
    "sim:long": "node tools/sim.js --players 12 --seconds 300 --report reports/sim-long.json",
    "doctor": "node tools/doctor.js",
    "verify": "npm run build && npm run check && npm run test && node tools/sim.js --players 6 --seconds 45",
    "package": "node tools/package.js",
    "release": "npm run verify && node tools/package.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
